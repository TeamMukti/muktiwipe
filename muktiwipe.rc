// ---------------------------------------------------------------
//  muktiwipe.rc - Windows version resource
//
//  Alimente l'onglet "Details" des proprietes de muktiwipe.exe
//  (clic droit > Proprietes > Details) : description, societe,
//  version du fichier et du produit.
//
//  Keep this file ASCII-only: rc.exe does not read /utf-8.
// ---------------------------------------------------------------

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L        // VOS_NT_WINDOWS32
FILETYPE        0x1L            // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"        // English (US), Unicode
        BEGIN
            VALUE "CompanyName",      "Team Mukti"
            VALUE "FileDescription",  "Suppression rapide de dossiers et de fichiers protégés"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "muktiwipe"
            VALUE "LegalCopyright",   "Team Mukti"
            VALUE "OriginalFilename", "muktiwipe.exe"
            VALUE "ProductName",      "muktiwipe"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
